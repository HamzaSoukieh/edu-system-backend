# Test environment example. Copy to .env.test for local test runs.
# Tests use in-memory model/service logic; a Mongo replica set is required only for
# integration/transaction tests (Phase 14+). Point MONGO_URI at a disposable test DB.
PORT=5001
NODE_ENV=test

MONGO_URI=mongodb://127.0.0.1:27017/edu-saas-test?replicaSet=rs0&directConnection=true

JWT_SECRET=test-only-throwaway-jwt-secret
QR_JWT_SECRET=test-only-throwaway-qr-secret

FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# No real email in tests: leave SMTP/Gmail unset -> non-prod stream transport (emails logged).
SMTP_HOST=
EMAIL_FROM=test@edu-system.local

REDIS_URL=redis://localhost:6379
EMAIL_QUEUE_ENABLED=false

STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
