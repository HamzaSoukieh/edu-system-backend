PORT=5000
NODE_ENV=development

# MongoDB. Production/Atlas example shown; for local dev use the replica set from
# docker-compose.dev.yml (transactions require a replica set):
#   MONGO_URI=mongodb://127.0.0.1:27017/edu-saas?replicaSet=rs0&directConnection=true
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.uj0qy.mongodb.net/edu-saas?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=replace-with-long-random-secret
QR_JWT_SECRET=replace-with-another-long-random-secret

FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# Email transport. Precedence: SMTP_HOST (e.g. Mailpit in dev) > Gmail > non-prod log fallback.
# Local dev (docker-compose.dev.yml Mailpit): SMTP_HOST=127.0.0.1 SMTP_PORT=1025
# Production must configure a real transport (SMTP_HOST or GMAIL_*). Never leave unset in prod.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

REDIS_URL=redis://localhost:6379
EMAIL_QUEUE_ENABLED=false
EMAIL_WORKER_CONCURRENCY=2

# Billing (Stripe). REQUIRED for checkout/upgrade. Until these hold REAL Stripe
# test-mode values, the billing API returns a structured
#   { "message": "Billing is temporarily unavailable", "code": "BILLING_NOT_CONFIGURED" }
# (503) instead of attempting a doomed checkout — it never returns a masked 500.
# Get a test secret key from https://dashboard.stripe.com/test/apikeys and create
# two recurring test Prices (Plus + Pro, 6-month), then paste their price_… IDs
# below. See docs/BILLING_SETUP.md for the full local Stripe workflow.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PLUS_6_MONTH=price_replace_me
STRIPE_PRICE_PRO_6_MONTH=price_replace_me

# Where Stripe returns the browser after checkout. The success URL must include
# the {CHECKOUT_SESSION_ID} template so the app can confirm the session.
BILLING_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
