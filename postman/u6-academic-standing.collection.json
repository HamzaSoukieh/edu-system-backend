{
  "info": {
    "_postman_id": "a7d3d5d6-u6-academic-standing",
    "name": "Edu SaaS - U6 Academic Standing",
    "description": "Manual API checks for U6B academicStandingRules and U6C university academic standing dashboards. Fixture creation is documented in the guide because finalized academic outcomes require existing semesters, sections, enrollments, assessments, and results.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login Owner/Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('owner login returns accessToken', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().accessToken).to.be.a('string');",
                  "});",
                  "pm.environment.set('ownerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Instructor",
