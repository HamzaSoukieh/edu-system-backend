        {
          "name": "Pagination - limit 25",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('pagination request succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('pagination fields are present', () => {",
                  "  const p = pm.response.json().pagination;",
                  "  pm.expect(p.page).to.eql(1);",
                  "  pm.expect(p.limit).to.eql(25);",
                  "  pm.expect(p).to.have.property('total');",
