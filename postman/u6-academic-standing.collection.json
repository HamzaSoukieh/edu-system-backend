          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-standing/university/summary"
          }
        },
        {
          "name": "Standing Summary - Filter Suspension",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('filtered summary succeeds', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().standingSummary;",
