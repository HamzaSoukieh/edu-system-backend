                  "pm.test('summary succeeds', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().standingSummary;",
                  "pm.test('summary has all standing buckets', () => {",
                  "  ['totalStudents', 'good_standing', 'academic_warning', 'probation', 'suspension', 'review_required', 'no_standing_yet'].forEach(k => pm.expect(s).to.have.property(k));",
