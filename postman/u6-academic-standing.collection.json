          }
        },
        {
          "name": "Standing Students - Page 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
