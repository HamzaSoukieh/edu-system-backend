    {
      "name": "02 Academic Policy Standing Rules",
      "item": [
        {
          "name": "List Academic Policies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('policy list succeeds', () => pm.response.to.have.status(200));",
                  "const policies = pm.response.json().academicPolicies || [];",
                  "pm.test('academicPolicies is an array', () => pm.expect(policies).to.be.an('array'));",
                  "if (policies.length && !pm.environment.get('academicPolicyId')) {",
                  "  pm.environment.set('academicPolicyId', policies[0].id || policies[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies"
          }
        },
        {
          "name": "Get Academic Policy - academicStandingRules Present",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('get policy succeeds', () => pm.response.to.have.status(200));",
                  "const policy = pm.response.json().academicPolicy;",
                  "pm.test('policy has academicStandingRules', () => {",
                  "  pm.expect(policy).to.be.an('object');",
                  "  pm.expect(policy.academicStandingRules).to.be.an('object');",
                  "  pm.expect(policy.academicStandingRules.bands).to.be.an('array');",
                  "});",
                  "if (policy && (policy.id || policy._id)) pm.environment.set('academicPolicyId', policy.id || policy._id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies/{{academicPolicyId}}"
          }
        },
        {
          "name": "Create Policy - academicStandingRules Omitted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create succeeds or conflicts with existing effective semester', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const policy = pm.response.json().academicPolicy;",
                  "  pm.environment.set('createdAcademicPolicyId', policy.id || policy._id);",
                  "  pm.test('created policy resolves default academicStandingRules', () => {",
                  "    pm.expect(policy.academicStandingRules).to.be.an('object');",
                  "    pm.expect(policy.academicStandingRules.enabled).to.eql(true);",
                  "    pm.expect(policy.academicStandingRules.noOutcomeStanding).to.eql('no_standing_yet');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"U6 Standing Policy {{$timestamp}}\",\n  \"effectiveFromSemesterId\": \"{{semesterId}}\",\n  \"minimumEnrollmentCreditHours\": 0,\n  \"defaultMaxCreditHours\": 18,\n  \"overloadMinGpa\": 3.5,\n  \"overloadMaxCreditHours\": 24,\n  \"outcomeThresholds\": {\n    \"failedMaxPercentage\": 59.99,\n    \"improvableMinPercentage\": 60,\n    \"improvableMaxPercentage\": 69.99,\n    \"finalPassMinPercentage\": 70\n  },\n  \"gpaBands\": [\n    { \"minPercentage\": 0, \"maxPercentage\": 60, \"gradePoint\": 0 },\n    { \"minPercentage\": 60, \"maxPercentage\": 70, \"gradePoint\": 2 },\n    { \"minPercentage\": 70, \"maxPercentage\": 85, \"gradePoint\": 3 },\n    { \"minPercentage\": 85, \"maxPercentage\": 100, \"gradePoint\": 4 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies",
            "description": "Optional fixture helper. If a policy already exists for semesterId, a 409 conflict is expected."
          }
        },
        {
          "name": "Patch Policy - Default Enabled Rules",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('patch default rules succeeds', () => pm.response.to.have.status(200));",
                  "const rules = pm.response.json().academicPolicy.academicStandingRules;",
                  "pm.test('default standing rules returned', () => {",
                  "  pm.expect(rules.enabled).to.eql(true);",
                  "  pm.expect(rules.noOutcomeStanding).to.eql('no_standing_yet');",
                  "  pm.expect(rules.requireManualReviewIfIncompleteProfile).to.eql(true);",
                  "  pm.expect(rules.bands.map(b => b.standing)).to.include.members(['good_standing', 'academic_warning', 'probation', 'suspension']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academicStandingRules\": {\n    \"enabled\": true,\n    \"bands\": [\n      {\n        \"standing\": \"good_standing\",\n        \"minCumulativeGpa\": 2.0,\n        \"allowedToContinue\": true,\n        \"requiresAdvisorReview\": false\n      },\n      {\n        \"standing\": \"academic_warning\",\n        \"minCumulativeGpa\": 1.7,\n        \"maxCumulativeGpaExclusive\": 2.0,\n        \"allowedToContinue\": true,\n        \"requiresAdvisorReview\": false\n      },\n      {\n        \"standing\": \"probation\",\n        \"minCumulativeGpa\": 1.0,\n        \"maxCumulativeGpaExclusive\": 1.7,\n        \"allowedToContinue\": true,\n        \"requiresAdvisorReview\": true\n      },\n      {\n        \"standing\": \"suspension\",\n        \"maxCumulativeGpaExclusive\": 1.0,\n        \"allowedToContinue\": false,\n        \"requiresAdvisorReview\": true\n      }\n    ],\n    \"requireManualReviewIfIncompleteProfile\": true,\n    \"noOutcomeStanding\": \"no_standing_yet\",\n    \"allowManualReview\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies/{{academicPolicyId}}"
          }
        },
        {
          "name": "Patch Policy - Custom Suspension Below 1.2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('patch custom rules succeeds', () => pm.response.to.have.status(200));",
                  "const bands = pm.response.json().academicPolicy.academicStandingRules.bands;",
                  "const suspension = bands.find(b => b.standing === 'suspension');",
                  "pm.test('custom suspension threshold is 1.2', () => pm.expect(suspension.maxCumulativeGpaExclusive).to.eql(1.2));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academicStandingRules\": {\n    \"enabled\": true,\n    \"bands\": [\n      {\n        \"standing\": \"suspension\",\n        \"maxCumulativeGpaExclusive\": 1.2,\n        \"allowedToContinue\": false,\n        \"requiresAdvisorReview\": true\n      },\n      {\n        \"standing\": \"probation\",\n        \"minCumulativeGpa\": 1.2,\n        \"maxCumulativeGpaExclusive\": 2.0,\n        \"allowedToContinue\": true,\n        \"requiresAdvisorReview\": true\n      },\n      {\n        \"standing\": \"academic_warning\",\n        \"minCumulativeGpa\": 2.0,\n        \"maxCumulativeGpaExclusive\": 2.5,\n        \"allowedToContinue\": true,\n        \"requiresAdvisorReview\": false\n      },\n      {\n        \"standing\": \"good_standing\",\n        \"minCumulativeGpa\": 2.5,\n        \"allowedToContinue\": true,\n        \"requiresAdvisorReview\": false\n      }\n    ],\n    \"requireManualReviewIfIncompleteProfile\": true,\n    \"noOutcomeStanding\": \"no_standing_yet\",\n    \"allowManualReview\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies/{{academicPolicyId}}"
          }
        },
        {
          "name": "Patch Policy - Disable academicStandingRules",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('disable rules succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('rules disabled in response', () => pm.expect(pm.response.json().academicPolicy.academicStandingRules.enabled).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"academicStandingRules\": {\n    \"enabled\": false\n  }\n}" },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies/{{academicPolicyId}}"
          }
        },
        {
          "name": "Patch Policy - Restore Default Enabled Rules",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academicStandingRules\": {\n    \"enabled\": true,\n    \"bands\": [\n      { \"standing\": \"suspension\", \"maxCumulativeGpaExclusive\": 1.0, \"allowedToContinue\": false, \"requiresAdvisorReview\": true },\n      { \"standing\": \"probation\", \"minCumulativeGpa\": 1.0, \"maxCumulativeGpaExclusive\": 1.7, \"allowedToContinue\": true, \"requiresAdvisorReview\": true },\n      { \"standing\": \"academic_warning\", \"minCumulativeGpa\": 1.7, \"maxCumulativeGpaExclusive\": 2.0, \"allowedToContinue\": true, \"requiresAdvisorReview\": false },\n      { \"standing\": \"good_standing\", \"minCumulativeGpa\": 2.0, \"allowedToContinue\": true, \"requiresAdvisorReview\": false }\n    ],\n    \"requireManualReviewIfIncompleteProfile\": true,\n    \"noOutcomeStanding\": \"no_standing_yet\",\n    \"allowManualReview\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies/{{academicPolicyId}}"
          }
        }
      ]
    },
    {
      "name": "03 Single Student Academic Profile",
      "item": [
        {
          "name": "Get Academic Profile - Standing Metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('profile succeeds', () => pm.response.to.have.status(200));",
                  "const profile = pm.response.json().academicProfile;",
                  "pm.test('academicStanding response shape exists', () => {",
                  "  pm.expect(profile).to.be.an('object');",
                  "  pm.expect(profile.academicStanding).to.be.an('object');",
                  "  pm.expect(profile.academicStanding).to.have.property('enabled');",
                  "  pm.expect(profile.academicStanding).to.have.property('standing');",
                  "  pm.expect(profile.academicStanding).to.have.property('allowedToContinue');",
                  "  pm.expect(profile.academicStanding).to.have.property('requiresAdvisorReview');",
                  "  pm.expect(profile.academicStanding.reasonCodes).to.be.an('array');",
                  "  pm.expect(profile.academicStanding.warnings).to.be.an('array');",
                  "  pm.expect(profile.academicStanding).to.have.property('appliedBand');",
                  "  pm.expect(profile.academicStanding.calculationMode).to.eql('live');",
                  "  pm.expect(profile.academicStanding.source).to.eql('academic_profile');",
                  "});",
                  "pm.test('U5B profile metadata remains available when present', () => {",
                  "  if (profile.repeatPolicy !== undefined) pm.expect(profile.repeatPolicy).to.be.an('object');",
                  "  if (profile.gpaCalculation !== undefined) pm.expect(profile.gpaCalculation).to.be.an('object');",
                  "  if (profile.earnedCreditCalculation !== undefined) pm.expect(profile.earnedCreditCalculation).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/{{studentMembershipId}}/academic-profile"
          }
        },
        {
          "name": "Get My Academic Profile - Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student self profile succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('self profile includes academicProfile envelope', () => pm.expect(pm.response.json().academicProfile).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/me/academic-profile"
          }
        }
      ]
    },
    {
