            "type": "text/javascript",
            "exec": [
              "const json = (() => { try { return pm.response.json(); } catch (error) { return {}; } })();",
              "const inactiveId = pm.environment.get('inactiveAssignmentId');",
              "const ids = (json.responsibilityAssignments || []).map((assignment) => assignment.id);",
              "pm.test('deactivated id is not activeNow', function () {",
              "  if (inactiveId) pm.expect(ids).to.not.include(inactiveId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Admin - Optional Patch Deactivate Head Assignment",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "200,404"
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/institutions/{{institutionId}}/responsibility-assignments/{{headDepartmentAssignmentId}}/deactivate",
        "description": "Optional cleanup. Run requests 01 and 02 again before testing Head-token oversight after this cleanup step."
      }
    },
    {
      "name": "24 Head - Oversight Blocked After Optional Cleanup",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "403"
        }
      ],
      "request": {
