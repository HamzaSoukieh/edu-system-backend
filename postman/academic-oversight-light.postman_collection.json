{
  "info": {
    "name": "Edu SaaS Academic Oversight Light Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Small local smoke flow for owner/admin ResponsibilityAssignment management plus read-only Head academic oversight. Import the matching local environment, run the backend locally, then run requests in order."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function jsonBody() {",
          "  try { return pm.response.json(); } catch (error) { return null; }",
          "}",
          "const expectedStatus = pm.variables.get('expectedStatus');",
          "if (expectedStatus) {",
          "  const statuses = String(expectedStatus).split(',').map((value) => Number(value.trim())).filter(Boolean);",
          "  pm.test(`status is ${expectedStatus}`, function () {",
          "    pm.expect(statuses).to.include(pm.response.code);",
          "  });",
          "}",
          "pm.test('response is JSON', function () {",
          "  pm.expect(jsonBody()).to.not.equal(null);",
          "});",
          "const json = jsonBody() || {};",
          "if (json.responsibilityAssignment) {",
          "  pm.test('assignment response omits permissions', function () {",
          "    pm.expect(json.responsibilityAssignment).to.not.have.property('permissions');",
          "  });",
          "}",
          "if (Array.isArray(json.responsibilityAssignments)) {",
          "  pm.test('assignment list omits permissions', function () {",
          "    json.responsibilityAssignments.forEach((assignment) => pm.expect(assignment).to.not.have.property('permissions'));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Admin - Institution Context",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "200"
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/institutions/me"
      }
    },
    {
      "name": "01 Admin - Create Or Reactivate Head Department Assignment",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "201,409"
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/institutions/{{institutionId}}/responsibility-assignments",
        "description": "Creates or reactivates the Head assignment needed by the Head-token oversight requests. If an active duplicate already exists, 409 is accepted and the next request saves its id.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{headUserId}}\",\n  \"responsibilityType\": \"head\",\n  \"scopeType\": \"department\",\n  \"scopeId\": \"{{departmentId}}\",\n  \"isActive\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = (() => { try { return pm.response.json(); } catch (error) { return {}; } })();",
              "if (json.responsibilityAssignment?.id) {",
              "  pm.environment.set('headDepartmentAssignmentId', json.responsibilityAssignment.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Admin - List And Save Head Assignment",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "200"
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/institutions/{{institutionId}}/responsibility-assignments?userId={{headUserId}}&responsibilityType=head&scopeType=department&scopeId={{departmentId}}&activeNow=true&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = (() => { try { return pm.response.json(); } catch (error) { return {}; } })();",
              "const departmentId = pm.environment.get('departmentId');",
              "const assignment = (json.responsibilityAssignments || []).find((item) => item.responsibilityType === 'head' && item.scopeType === 'department' && item.scopeId === departmentId && item.isActive === true);",
              "pm.test('active head department assignment exists', function () {",
              "  pm.expect(assignment).to.be.ok;",
              "});",
              "if (assignment?.id) {",
              "  pm.environment.set('headDepartmentAssignmentId', assignment.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Admin - Create Coordinator Section Assignment",
