    {
      "name": "19 Student - Token Context Shows Student Role",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "200"
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/institutions/me",
        "description": "Diagnostic guard: this must show studentEmail as a student membership. If it shows admin/instructor, Postman is using stale current environment values."
      },
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{studentToken}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = (() => { try { return pm.response.json(); } catch (error) { return {}; } })();",
              "const institutionId = pm.environment.get('institutionId');",
              "const expectedEmail = pm.environment.get('studentEmail');",
              "const membership = (json.institutions || []).find((item) => item.institutionId === institutionId);",
              "pm.test('student token email matches environment studentEmail', function () {",
              "  pm.expect(json.user?.email).to.equal(expectedEmail);",
              "});",
              "pm.test('student token has student membership in selected institution', function () {",
              "  pm.expect(membership).to.be.ok;",
              "  pm.expect(membership.role).to.equal('student');",
              "  pm.expect(membership.membershipStatus).to.equal('active');",
              "});",
              "pm.test('student token is not institution owner', function () {",
              "  pm.expect(membership?.isOwner).to.equal(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Student - Academic Oversight Is Blocked",
      "variable": [
        {
          "key": "expectedStatus",
          "value": "403"
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-oversight/risk-summary",
        "description": "Must return 403. If this returns 200, first check request 19: Postman is probably using an old current value for studentToken."
      },
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{studentToken}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.environment.get('studentToken') || '';",
              "const expectedUserId = pm.environment.get('studentUserId');",
              "function decodeJwtPayload(rawToken) {",
              "  const payload = rawToken.split('.')[1] || '';",
              "  const normalized = payload.replace(/-/g, '+').replace(/_/g, '/');",
              "  const padded = normalized + '='.repeat((4 - normalized.length % 4) % 4);",
              "  return JSON.parse(atob(padded));",
              "}",
              "pm.test('studentToken subject matches studentUserId', function () {",
              "  const payload = decodeJwtPayload(token);",
              "  pm.expect(payload.sub).to.equal(expectedUserId);",
              "});"
            ]
          }
        }
      ]
    },
