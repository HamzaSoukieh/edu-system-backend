    {
      "name": "03 Academic Profile Repeat Policy Checks",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Staff Profile - Default best_attempt_only / count_once_per_subject",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('profile returns 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().academicProfile || {};",
                  "const attempts = (p.subjectAttempts || []).filter(a => a.subjectId === pm.environment.get('repeatedSubjectId'));",
                  "pm.test('repeatPolicy appears on profile', () => {",
                  "  pm.expect(p.repeatPolicy).to.be.an('object');",
                  "  pm.expect(p.repeatPolicy.gpaCalculationMethod).to.eql('best_attempt_only');",
                  "  pm.expect(p.repeatPolicy.earnedCreditsMethod).to.eql('count_once_per_subject');",
                  "});",
                  "pm.test('repeated subject attempts stay visible', () => pm.expect(attempts.length).to.be.at.least(2));",
                  "pm.test('only best repeated attempt is included in official GPA', () => pm.expect(attempts.filter(a => a.includedInOfficialGpa).length).to.eql(1));",
                  "pm.test('excluded attempt has repeat_policy_best_attempt_only', () => pm.expect(attempts.map(a => a.excludedReasonCode).filter(Boolean)).to.include('repeat_policy_best_attempt_only'));",
                  "pm.test('earned credits counted once for repeated subject', () => pm.expect(attempts.filter(a => a.earnedCreditsCounted).length).to.eql(1));",
                  "pm.test('summary earned credits do not double count 3-credit repeated subject', () => pm.expect(p.summary.totalEarnedCreditHours).to.be.at.most(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/{{studentMembershipId}}/academic-profile"
          }
        },
        {
          "name": "Student Self Profile - Repeat Fields Visible",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('self profile returns 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().academicProfile || {};",
                  "pm.test('repeatPolicy appears to student', () => pm.expect(p.repeatPolicy).to.be.an('object'));",
                  "pm.test('subjectAttempts include repeat flags', () => {",
                  "  const attempt = (p.subjectAttempts || []).find(a => a.subjectId === pm.environment.get('repeatedSubjectId'));",
                  "  pm.expect(attempt).to.be.an('object');",
                  "  pm.expect(attempt).to.have.property('includedInOfficialGpa');",
                  "  pm.expect(attempt).to.have.property('earnedCreditsCounted');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/me/academic-profile"
          }
        },
        {
          "name": "Profile - AP4 Excluded Explanation Shape",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('profile returns 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().academicProfile || {};",
                  "pm.test('excluded explanation array still exists', () => pm.expect(p.excluded).to.be.an('array'));",
                  "pm.test('excluded entries use reasonCode/message shape', () => {",
                  "  (p.excluded || []).forEach(e => { pm.expect(e.reasonCode).to.be.a('string'); pm.expect(e).to.have.property('message'); });",
                  "});",
                  "const codes = (p.excluded || []).map(e => e.reasonCode);",
                  "console.log('AP4/repeat excluded reason codes:', codes);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
