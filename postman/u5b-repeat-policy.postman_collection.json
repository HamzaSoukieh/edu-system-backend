            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"U5B Previous Semester {{fixtureTag}}\",\n  \"startDate\": \"2026-01-05\",\n  \"endDate\": \"2026-03-31\",\n  \"teachingDays\": [\"monday\", \"tuesday\", \"wednesday\", \"thursday\"],\n  \"status\": \"archived\"\n}"
            },
