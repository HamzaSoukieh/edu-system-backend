{
  "info": {
    "_postman_id": "aa605bb0-u5b-repeat-policy",
    "name": "Edu SaaS - U5B University Repeat Policy",
    "description": "Manual end-to-end checks for U5B admin-configurable university repeatPolicy. Uses the live auth, institution academic policy, academic profile, section/enrollment/assessment, and self-enrollment routes wired in this backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('fixtureTag')) {",
          "  pm.environment.set('fixtureTag', 'U5B' + Date.now().toString().slice(-6));",
          "}",
          "function requireEnv(name) {",
          "  if (!pm.environment.get(name)) console.warn('Missing environment variable: ' + name);",
          "}",
          "requireEnv('baseUrl');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Auth And Context",
      "item": [
        {
          "name": "Owner/Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('owner/admin login returns 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('accessToken returned', () => pm.expect(json.accessToken).to.be.a('string'));",
                  "if (json.accessToken) pm.environment.set('ownerToken', json.accessToken);",
                  "if (json.user && json.user.id) pm.environment.set('ownerUserId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Requires an existing verified owner/admin with an active university membership and institution.manage/membership.manage/section.manage permissions."
          }
        },
        {
          "name": "Get My Institution Context",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('context request succeeds', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.activeInstitutionId && !pm.environment.get('institutionId')) pm.environment.set('institutionId', json.activeInstitutionId);",
                  "if (json.institution && json.institution.id && !pm.environment.get('institutionId')) pm.environment.set('institutionId', json.institution.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/institutions/me",
            "description": "Optional helper. If this response shape does not expose institutionId, set institutionId manually in the environment."
          }
        },
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student login returns 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('student accessToken returned', () => pm.expect(json.accessToken).to.be.a('string'));",
                  "if (json.accessToken) pm.environment.set('studentToken', json.accessToken);",
                  "if (json.user && json.user.id) pm.environment.set('studentUserId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Run after creating the fixture student or use an existing active university student account."
          }
        }
      ]
    },
    {
