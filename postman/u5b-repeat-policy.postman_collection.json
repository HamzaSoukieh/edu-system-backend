          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/me/self-enrollment/sections/{{prereqTargetSectionId}}/eligibility",
            "description": "For best_passed_attempt vs latest_attempt divergence, create prerequisite subject attempts where an earlier attempt passes and the latest attempt fails, then switch prerequisiteMethod before finalizing or use separate fixtures."
          }
        }
