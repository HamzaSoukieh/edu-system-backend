        {
          "name": "Create Latest Active Semester",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('latest semester created or active-semester conflict is visible', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code !== 201) return;",
                  "const json = pm.response.json();",
                  "if (json.semester && json.semester.id) {",
                  "  pm.environment.set('activeSemesterId', json.semester.id);",
                  "  pm.environment.set('latestSemesterId', json.semester.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"U5B Latest Semester {{fixtureTag}}\",\n  \"startDate\": \"2026-04-01\",\n  \"endDate\": \"2026-06-30\",\n  \"teachingDays\": [\"monday\", \"tuesday\", \"wednesday\", \"thursday\"],\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/semesters",
            "description": "If your institution already has an active semester, set activeSemesterId/latestSemesterId manually or archive the old fixture semester first."
          }
        },
        {
          "name": "Create Academic Policy - repeatPolicy Omitted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('policy created', () => pm.response.to.have.status(201));",
                  "const policy = pm.response.json().academicPolicy || {};",
                  "if (policy.id) pm.environment.set('academicPolicyId', policy.id);",
                  "pm.test('default repeatPolicy is resolved', () => {",
                  "  pm.expect(policy.repeatPolicy).to.be.an('object');",
                  "  pm.expect(policy.repeatPolicy.enabled).to.eql(true);",
                  "  pm.expect(policy.repeatPolicy.gpaCalculationMethod).to.eql('best_attempt_only');",
                  "  pm.expect(policy.repeatPolicy.earnedCreditsMethod).to.eql('count_once_per_subject');",
                  "  pm.expect(policy.repeatPolicy.prerequisiteMethod).to.eql('best_passed_attempt');",
                  "  pm.expect(policy.repeatPolicy.allowGradeImprovementRepeats).to.eql(true);",
                  "  pm.expect(policy.repeatPolicy.blockRepeatAfterFinalPass).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"U5B Repeat Policy {{fixtureTag}}\",\n  \"status\": \"active\",\n  \"effectiveFromSemesterId\": \"{{previousSemesterId}}\",\n  \"minimumEnrollmentCreditHours\": 0,\n  \"defaultMaxCreditHours\": 18,\n  \"overloadMinGpa\": 3.5,\n  \"overloadMaxCreditHours\": 24,\n  \"outcomeThresholds\": {\n    \"failedMaxPercentage\": 59.99,\n    \"improvableMinPercentage\": 60,\n    \"improvableMaxPercentage\": 69.99,\n    \"finalPassMinPercentage\": 70\n  },\n  \"gpaBands\": [\n    { \"minPercentage\": 0, \"maxPercentage\": 60, \"gradePoint\": 0 },\n    { \"minPercentage\": 60, \"maxPercentage\": 70, \"gradePoint\": 2 },\n    { \"minPercentage\": 70, \"maxPercentage\": 85, \"gradePoint\": 3 },\n    { \"minPercentage\": 85, \"maxPercentage\": 100, \"gradePoint\": 4 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/institutions/{{institutionId}}/academic-policies",
            "description": "repeatPolicy is intentionally omitted. The response should resolve the U5B default repeatPolicy."
          }
        },
