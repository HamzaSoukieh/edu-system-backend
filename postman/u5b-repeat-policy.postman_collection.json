    {
      "name": "04 Self-Enrollment Repeat Behavior",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Preview Repeat Target - passed_final Default Blocks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('eligibility request returns 200 or policy/load conflict is visible', () => pm.expect([200, 409]).to.include(pm.response.code));",
                  "if (pm.response.code !== 200) return;",
                  "const e = pm.response.json().eligibility || {};",
                  "pm.test('same-subject repeat summary exists', () => pm.expect(e.sameSubjectSummary).to.be.an('object'));",
                  "pm.test('passed_final blocks when blockRepeatAfterFinalPass is true', () => {",
                  "  pm.expect(e.blockingReasonCodes || []).to.include('same_subject_already_passed_final');",
                  "  pm.expect(e.sameSubjectSummary.repeatPolicy.blockRepeatAfterFinalPass).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/me/self-enrollment/sections/{{repeatTargetSectionId}}/eligibility"
          }
        },
        {
          "name": "Preview Repeat Target - after allowing passed_final",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('eligibility request returns 200 or setup conflict is visible', () => pm.expect([200, 409]).to.include(pm.response.code));",
                  "if (pm.response.code !== 200) return;",
                  "const e = pm.response.json().eligibility || {};",
                  "pm.test('repeatPolicy is reported in policySummary', () => pm.expect(e.policySummary.repeatPolicy).to.be.an('object'));",
                  "pm.test('passed_final blocker absent when blockRepeatAfterFinalPass is false', () => {",
                  "  if (e.policySummary.repeatPolicy.blockRepeatAfterFinalPass === false) {",
                  "    pm.expect(e.blockingReasonCodes || []).to.not.include('same_subject_already_passed_final');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/institutions/{{institutionId}}/students/me/self-enrollment/sections/{{repeatTargetSectionId}}/eligibility",
            "description": "Run the policy update Set Repeat Flags - Allow Both before finalizing outcomes, or use a fixture whose active policy already has blockRepeatAfterFinalPass=false."
          }
        },
