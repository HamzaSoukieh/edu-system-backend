NODE_ENV=production
HOST=0.0.0.0
PORT=5000

MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=edu-system
MONGO_URI=mongodb://USERNAME:PASSWORD@mongo:27017/edu-system?authSource=admin

FRONTEND_URL=https://app.example.com
FRONTEND_URLS=https://app.example.com

JWT_SECRET=
JWT_EXPIRES_IN=7d
QR_JWT_SECRET=
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

REDIS_URL=redis://redis:6379
EMAIL_QUEUE_ENABLED=true
EMAIL_WORKER_CONCURRENCY=2

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_6_MONTH=
STRIPE_PRICE_PRO_6_MONTH=

BILLING_SUCCESS_URL=https://app.example.com/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=https://app.example.com/billing/cancel

MAX_LOGO_SIZE_MB=2
MAX_PROFILE_PICTURE_SIZE_MB=2
MAX_SECTION_MATERIAL_SIZE_MB=10
MAX_HOMEWORK_SUBMISSION_SIZE_MB=10
